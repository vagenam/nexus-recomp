  PRE_LINK = cd .
  TARGET_COMPILE_PDB = CMakeFiles\SDL2-static.dir\SDL2-static.pdb
  TARGET_FILE = libSDL2.a
  TARGET_PDB = libSDL2.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\SDL2-static.dir
  RSP_FILE = CMakeFiles\SDL2-static.rsp


